# =============================================================================
# .env.example — copie para .env.local (dev) e configure no painel da Vercel (prod)
# =============================================================================
# APENAS INFRA vive aqui. Credenciais de integração (Meta, Hotmart, Kiwify) e
# branding NÃO ficam em env — são configurados pelo painel e cifrados no banco.
# NUNCA faça commit do .env.local (o .gitignore já protege).
# =============================================================================

# --- Supabase (Project Settings -> API) --------------------------------------
# URL do projeto Supabase.
NEXT_PUBLIC_SUPABASE_URL="https://SEU-PROJETO.supabase.co"

# Chave pública do cliente. Use a "anon key" (legado) OU a nova "publishable key".
# Client-safe: pode ir para o browser (protegida por RLS).
NEXT_PUBLIC_SUPABASE_ANON_KEY="sua-anon-ou-publishable-key"

# Chave privilegiada do servidor. Use a "service_role key" (legado) OU a nova
# "secret key". SOMENTE no servidor — faz BYPASS de RLS. NUNCA use NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY="sua-service-role-ou-secret-key"

# --- Criptografia dos segredos (pgcrypto) ------------------------------------
# Chave simétrica usada para cifrar/decifrar os tokens das integrações no banco.
# Gere uma forte e ALEATÓRIA (ex.: `openssl rand -base64 48`). NUNCA commitada.
# Se você perder esta chave, os segredos cifrados no banco ficam irrecuperáveis.
ENCRYPTION_KEY="troque-por-uma-chave-aleatoria-longa"

# --- Onboarding de primeira execução -----------------------------------------
# Token que protege a rota /setup (cria o 1º admin e a 1ª área). Depois que existe
# um usuário, a rota se desativa. Gere um valor aleatório e guarde com segurança.
SETUP_TOKEN="troque-por-um-token-aleatorio"
